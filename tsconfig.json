{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],                       // 1. Give TypeScript access to Node types
    "esModuleInterop": true,                 // 2. Allow clean imports for CommonJS legacy packages

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": false,           // 3. Set this to false to stop the import syntax errors
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}